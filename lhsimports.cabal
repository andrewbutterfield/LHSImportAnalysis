executable lhsimports
  main-is: Main.lhs
  other-modules:
      Paths_lhsimports
  hs-source-dirs:
      app
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , directory
    , lhsimports
  default-language: Haskell2010

test-suite lhsimports-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Paths_lhsimports
  hs-source-dirs:
      test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , directory
    , lhsimports
  default-language: Haskell2010
